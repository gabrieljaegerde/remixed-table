# REMIXED TABLE — environment variables
# Copy to `.env.local` for local dev (never commit real values). In production,
# set these in the Vercel dashboard: Project → Settings → Environment Variables.

# Stripe SECRET key — server only, never exposed to the browser.
# Use a TEST key (sk_test_...) until you're ready to go live (sk_live_...).
STRIPE_SECRET_KEY=sk_test_replace_me

# Webhook signing secret. Locally this is printed by `stripe listen`
# (whsec_...). In production it's the endpoint's signing secret in the
# Stripe Dashboard → Developers → Webhooks.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Optional: force the base URL used for success/cancel redirects.
# Leave unset to auto-detect from the request (recommended on Vercel).
# SITE_URL=https://remixedtable.com
